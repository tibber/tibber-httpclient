{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "sourceMap": true,
    "allowJs": true,
    "strict": true,
    "noUnusedParameters": true,
    "target": "ES2019",
    "module": "node20",
    "isolatedModules": true
  },
  "include": [
    "./src",
    "./test",
    "./.prettierrc.json",
    "./package.json",
    "./eslint.config.mjs",
    "./renovate.json",
    "./jest.config.mjs",
    "./jest-setup.js"
  ]
}
